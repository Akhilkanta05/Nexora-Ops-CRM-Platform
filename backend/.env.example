# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL or SQLite for local zero-dependency run)
# For PostgreSQL (Docker, Neon, Supabase, Render):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_operations?schema=public"
# For zero-config local SQLite fallback:
# DATABASE_URL="file:./dev.db"

# JWT Secret & Expiration
JWT_SECRET=super_secret_jwt_key_wholesale_erp_2026_change_in_production
JWT_EXPIRES_IN=7d
